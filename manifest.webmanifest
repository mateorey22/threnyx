{
  "id": "./",
  "name": "MeshChat — Terminal privé",
  "short_name": "MeshChat",
  "description": "Messagerie privée MeshChat avec relais, chiffrement local et appels P2P.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "display": "standalone",
  "orientation": "any",
  "background_color": "#060606",
  "theme_color": "#060606",
  "prefer_related_applications": false,
  "categories": [
    "communication",
    "social"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
